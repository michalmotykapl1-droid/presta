{*
 * Ścieżka do pliku: /modules/geminicontent/views/templates/admin/import_preview.tpl
 *}
{extends file="helpers/view/view.tpl"}

{block name="override_tpl"}
<div class="panel">
    <h3><i class="icon-eye-open"></i> {l s='Podgląd importu z pliku CSV' mod='geminicontent'}</h3>
</div>

<div class="alert alert-info">
    <p>
        {l s='Poniżej znajduje się lista zmian, które zostaną wprowadzone po zatwierdzeniu. Sprawdź dokładnie, czy wszystkie dane są poprawne.' mod='geminicontent'}
        <br>
        <strong>{l s='Zaznacz produkty, które chcesz zaimportować.' mod='geminicontent'}</strong>
    </p>
</div>

<form method="post" action="{$current_controller_url|escape:'html':'UTF-8'}" id="form-confirm-import">
    
    <div class="import-preview-product-list">
        {if !empty($import_preview_data)}
            {foreach from=$import_preview_data item=product}
                <div class="panel import-preview-product">
                    <div class="panel-heading">
                        <input type="checkbox" name="products_to_import[]" value="{$product.id_product|intval}" class="js-product-import-checkbox" checked="checked" />
                        
                        <i class="icon-cube"></i>
                        <strong>{l s='Produkt:' mod='geminicontent'}</strong> {$product.name|escape:'html':'UTF-8'}

                        {* Przycisk podglądu *}
                        <button type="button" class="btn btn-default btn-sm js-preview-product-changes" data-id-product="{$product.id_product|intval}" style="margin-left: 15px;">
                            <i class="icon-eye"></i> {l s='Podgląd' mod='geminicontent'}
                        </button>
                        
                        <span class="pull-right">
                            {l s='ID:' mod='geminicontent'} {$product.id_product|intval} &nbsp;|&nbsp; {l s='SKU:' mod='geminicontent'} {$product.reference|escape:'html':'UTF-8'}
                        </span>
                    </div>

                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th class="fixed-width-lg">{l s='Zmieniane pole' mod='geminicontent'}</th>
                                <th>{l s='Stara zawartość (fragment)' mod='geminicontent'}</th>
                                <th>{l s='Nowa zawartość (fragment)' mod='geminicontent'}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {if !empty($product.description_ai)}
                                <tr>
                                    <td><strong>{l s='Nowy opis (AI)' mod='geminicontent'}</strong></td>
                                    <td class="text-muted">{$product.description|strip_tags|truncate:150:'...'}</td>
                                    <td class="text-success new-content-cell">{$product.description_ai|strip_tags|truncate:150:'...'}</td>
                                </tr>
                            {/if}
                            {if !empty($product.description_old_ai)}
                                <tr>
                                    <td><strong>{l s='Stary opis (sformatowany)' mod='geminicontent'}</strong></td>
                                    <td class="text-muted">{$product.description|strip_tags|truncate:150:'...'}</td>
                                    <td class="text-info new-content-cell">{$product.description_old_ai|strip_tags|truncate:150:'...'}</td>
                                </tr>
                            {/if}
                             {if !empty($product.sklad_ai)}
                                <tr>
                                    <td><strong>{l s='Skład (AI)' mod='geminicontent'}</strong></td>
                                    <td class="text-muted"><em>{l s='Dane zebrane z cech/opisu' mod='geminicontent'}</em></td>
                                    <td class="text-success new-content-cell">{$product.sklad_ai|truncate:150:'...'}</td>
                                </tr>
                            {/if}
                            {if !empty($product.wartosci_ai)}
                                <tr>
                                    <td><strong>{l s='Wartości odżywcze (AI)' mod='geminicontent'}</strong></td>
                                    <td class="text-muted"><em>{l s='Dane zebrane z cech/opisu' mod='geminicontent'}</em></td>
                                    <td class="text-success new-content-cell">{$product.wartosci_ai|truncate:150:'...'}</td>
                                </tr>
                            {/if}
                            {if !empty($product.meta_title_ai)}
                                <tr>
                                    <td><strong>{l s='Meta Tytuł' mod='geminicontent'}</strong></td>
                                    <td class="text-muted">{$product.meta_title}</td>
                                    <td class="text-success new-content-cell">{$product.meta_title_ai}</td>
                                </tr>
                            {/if}
                            {if !empty($product.meta_description_ai)}
                                <tr>
                                    <td><strong>{l s='Meta Opis' mod='geminicontent'}</strong></td>
                                    <td class="text-muted">{$product.meta_description|truncate:150:'...'}</td>
                                    <td class="text-success new-content-cell">{$product.meta_description_ai|truncate:150:'...'}</td>
                                </tr>
                            {/if}
                            {if !empty($product.link_rewrite_ai)}
                                <tr>
                                    <td><strong>{l s='Przyjazny URL' mod='geminicontent'}</strong></td>
                                    <td class="text-muted">{$product.link_rewrite}</td>
                                    <td class="text-success new-content-cell">{$product.link_rewrite_ai}</td>
                                </tr>
                            {/if}
                            {if !empty($product.tags_ai)}
                                <tr>
                                    <td><strong>{l s='Tagi' mod='geminicontent'}</strong></td>
                                    <td class="text-muted">{$product.tags}</td>
                                    <td class="text-success new-content-cell">{$product.tags_ai}</td>
                                </tr>
                            {/if}
                        </tbody>
                    </table>
                </div>
            {/foreach}
        {else}
            <div class="alert alert-warning">
                {l s='Brak danych do wyświetlenia. Plik mógł nie zawierać zmian w kolumnach _ai lub wystąpił błąd odczytu.' mod='geminicontent'}
            </div>
        {/if}
    </div>

    <div class="panel-footer">
        {if !empty($import_preview_data)}
            <a href="{$current_controller_url|escape:'html':'UTF-8'}&action=cancelImport" class="btn btn-default">
                <i class="process-icon-cancel"></i> {l s='Anuluj import i wróć' mod='geminicontent'}
            </a>
            
            <button type="button" class="btn btn-default" id="js-toggle-all-products">
                <i class="icon-check-square-o"></i> {l s='Odznacz/Zaznacz wszystko' mod='geminicontent'}
            </button>

            <button type="submit" name="submitConfirmImport" class="btn btn-primary pull-right">
                <i class="process-icon-save"></i> {l s='Zatwierdź i importuj ZAZNACZONE' mod='geminicontent'}
            </button>
        {else}
            <a href="{$current_controller_url|escape:'html':'UTF-8'}" class="btn btn-default">
                <i class="process-icon-cancel"></i> {l s='Wróć' mod='geminicontent'}
            </a>
        {/if}
    </div>
</form>

{* MODAL DLA PODGLĄDU PRODUKTU *}
<div class="modal fade" id="geminiProductPreviewModal" tabindex="-1" role="dialog" aria-labelledby="geminiProductPreviewModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="geminiProductPreviewModalLabel">{l s='Podgląd zmian produktu' mod='geminicontent'}</h4>
            </div>
            <div class="modal-body">
                <div class="modal-body-content">
                    <div class="text-center">
                        <i class="icon-spinner icon-spin" style="font-size: 3em;"></i>
                        <p>{l s='Ładowanie podglądu...' mod='geminicontent'}</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">{l s='Zamknij' mod='geminicontent'}</button>
            </div>
        </div>
    </div>
</div>

{addJsDefL name='gemini_confirm_import_none_selected'}{l s='Nie zaznaczono żadnego produktu do importu. Czy na pewno chcesz kontynuować (bez wprowadzania zmian)?' mod='geminicontent' js=1}{/addJsDefL}

<script type="text/javascript">
    $(document).ready(function() {
        $('#js-toggle-all-products').on('click', function() {
            var allCheckboxes = $('.js-product-import-checkbox');
            var isAnyChecked = allCheckboxes.is(':checked');
            allCheckboxes.prop('checked', !isAnyChecked);
        });

        $('#form-confirm-import').on('submit', function(e) {
            if ($('.js-product-import-checkbox:checked').length === 0) {
                if (!confirm(gemini_confirm_import_none_selected)) {
                    e.preventDefault();
                }
            }
        });

        // LOGIKA DLA PODGLĄDU
        $('.js-preview-product-changes').on('click', function() {
            var idProduct = $(this).data('id-product');
            var modal = $('#geminiProductPreviewModal');
            var modalBody = modal.find('.modal-body-content');

            modal.modal('show');
            modalBody.html('<div class="text-center"><i class="icon-spinner icon-spin" style="font-size: 3em;"></i><p>{l s="Ładowanie podglądu..." js=1}</p></div>');

            $.ajax({
                url: '{$current_controller_url|escape:'html':'UTF-8'}' + '&ajax=1&action=previewProductChanges',
                type: 'POST',
                dataType: 'json',
                data: {
                    id_product: idProduct,
                    ajax: true,
                    action: 'previewProductChanges',
                    token: prestashop.token // <<< KLUCZOWA POPRAWKA JEST TUTAJ
                },
                success: function(response) {
                    if (response.success) {
                        modalBody.html(response.html);
                    } else {
                        modalBody.html('<div class="alert alert-danger">' + (response.message || '{l s="Wystąpił nieznany błąd." js=1}') + '</div>');
                    }
                },
                error: function() {
                    modalBody.html('<div class="alert alert-danger">{l s="Błąd serwera podczas ładowania podglądu." js=1}</div>');
                }
            });
        });
    });
</script>
{/block}

