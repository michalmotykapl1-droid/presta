                    {
                        "type": "TEXT",
                        "content": "<h1>Suszone plastry brzoskwini Crispy Natural, 10g<\/h1> <p><b>Suszone plastry brzoskwini Crispy Natural, 10g <\/b><\/p> <p>Suszone chipsy z brzoskwini.<\/p> <p><b>Składniki:<\/b><\/p><p>brzoswinia<\/p> <p><b>Wartość odżywcza w 100g:<\/b><\/p><p>Wartość energetyczna 1392 kJ \/ 347 kcal<\/p><p>Tłuszcz 2,0 g<\/p><p>w tym kwasy tłuszczowe nasycone 0,12 g<\/p><p>Węglowodany 71 g<\/p><p>w tym cukry 36 g<\/p><p>Błonnik 11,4 g<\/p><p>Białko 5,7 g<\/p><p>Sól 0,1 g<\/p><p><b>Alergeny:<\/b><\/p><p>Brak.<\/p> <p><b>Sposób przechowywania: <\/b><\/p><p>Przechowywać w suchym i chłodnym miejscu. Spożyć bezpośrednio po otwarciu opakowania.<\/p> <p><b>Producent:<\/b><\/p><p>Crispy Natural Sp. z o. o. Sp. k.<\/p><p>ul. Łódzka 145a<\/p><p>62-800 Kalisz<\/p>"
                    }
                ]
            }
        ]
