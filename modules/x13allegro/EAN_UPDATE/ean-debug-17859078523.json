                    {
                        "type": "TEXT",
                        "content": "<h1>Suszone plastry truskawki Crispy Natural, 10 g<\/h1> <p><b>Suszone plastry truskawki Crispy Natural, 10g <\/b><\/p> <p>Truskawka 100% - Suszone chipsy z truskawek<\/p> <p><b>Składniki:<\/b><\/p><p>truskawka<\/p> <p><b>Wartość odżywcza w 100g:<\/b><\/p><p>Wartość energetyczna 1392 kJ \/ 331 kcal<\/p><p>Tłuszcz 3,4 g<\/p><p>w tym kwasy tłuszczowe nasycone 0,7 g<\/p><p>Węglowodany 57,3 g<\/p><p>w tym cukry 34 g<\/p><p>Błonnik 20,7 g<\/p><p>Białko 7,3 g<\/p><p>Sól 0,04 g<\/p><p><b>Alergeny:<\/b><\/p><p>Brak.<\/p> <p><b>Sposób przechowywania: <\/b><\/p><p>Przechowywać w suchym i chłodnym miejscu. Spożyć bezpośrednio po otwarciu opakowania.<\/p> <p><b>Producent:<\/b><\/p><p>Crispy Natural Sp. z o. o. Sp. k.<\/p><p>ul. Łódzka 145a<\/p><p>62-800 Kalisz<\/p>"
                    }
                ]
            }
